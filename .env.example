# Public app URL for metadata/sitemap links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only; never expose this key through NEXT_PUBLIC variables.
YOUTUBE_API_KEY="your-youtube-api-key"

# P2 is incomplete and must not be deployed. Configure only after security review.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
OWNER_USER_ID=""
APP_ORIGIN="http://localhost:3000"
# 32 or more random bytes encoded as hexadecimal; never commit a real value.
CSRF_HMAC_SECRET=""
