# Public app URL for metadata/sitemap links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# YouTube API mode:
# - proxy (recommended): calls local API route that uses server key
# - browser: direct client calls with public key
NEXT_PUBLIC_YOUTUBE_API_MODE="proxy"

# Required for proxy mode (kept server-side in Vercel env settings)
YOUTUBE_API_KEY="your-youtube-api-key"

# Required only for browser mode
# NEXT_PUBLIC_YOUTUBE_API_KEY="your-browser-restricted-api-key"
